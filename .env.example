# =============================================================================
# Application
# =============================================================================
# NODE_ENV        Runtime mode. Affects logging, cookie `secure` flag, CORS, Prisma logs, Sentry.
#                 Accepts: development | production | test
NODE_ENV=development
# APP_NAME        Used in Sentry serverName and error response messages.
APP_NAME=Node-Typescript-Boilerplate
# PORT            HTTP server port.
PORT=4000
# RATELIMIT       Global max requests per window (per IP). Integer.
RATELIMIT=100
# FRONTEND_URL    Base URL of the frontend. Used to build email-verification and password-reset links.
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Sockets
# =============================================================================
# SOCKET_DRIVER   WebSocket implementation. SocketIO shares the HTTP PORT (SOCKET_PORT ignored).
#                 Accepts: uWebSocket | SocketIO
SOCKET_DRIVER=uWebSocket
# SOCKET_PORT     Port for uWebSockets.js server (only used when SOCKET_DRIVER=uWebSocket).
SOCKET_PORT=4001
# PUBLIC_CHANNEL_ID   Default channel id clients may subscribe to without auth.
PUBLIC_CHANNEL_ID="public"
# SOCKET_SECRET   Secret for signing socket auth tokens. Falls back to JWT_SECRET if unset.
SOCKET_SECRET=

# =============================================================================
# Secrets / Auth
# =============================================================================
# JWT_SECRET      REQUIRED. Signs/verifies access & refresh tokens. App exits on boot if missing.
#                 Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# SESSION_SECRET  Secret for session/passport middleware.
SESSION_SECRET=
# CSRF_SECRET     REQUIRED for state-changing routes. Signs the CSRF cookie/token. Throws if missing.
CSRF_SECRET=
# REQUIRE_EMAIL_VERIFICATION   Block unverified users from authenticating. Accepts: true | false
REQUIRE_EMAIL_VERIFICATION=true
# LOGIN_THRESHOLD   Max failed login attempts before rate-limiting. Integer. Default 10.
LOGIN_THRESHOLD=10

# =============================================================================
# Cookies
# =============================================================================
# COOKIE_SAME_SITE   SameSite attribute for cookies. Accepts: lax | strict | none
COOKIE_SAME_SITE="lax"
# COOKIE_TTL         Cookie lifetime in seconds (converted to ms internally). Integer.
COOKIE_TTL=86400

# =============================================================================
# CORS
# =============================================================================
# ALLOWED_ORIGINS   Comma-separated allowlist of origins (production). Ignored in development (all allowed).
ALLOWED_ORIGINS="http://localhost:3000"

# =============================================================================
# Database (PostgreSQL) — use `postgres` as DATABASE_HOST when running via Docker
# =============================================================================
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
# DATABASE_URL    REQUIRED. Full connection string used by Prisma.
#                 Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# =============================================================================
# Mail
# =============================================================================
# MAIL_SERVICE    Transport type. Accepts: sendgrid | smtp
MAIL_SERVICE=
# MAIL_FROM       Default "from" address for outgoing mail.
MAIL_FROM=
# MAIL_HOST       SMTP host (smtp only).
MAIL_HOST=
# MAIL_PORT       SMTP port (smtp only). Default 587.
MAIL_PORT=587
# MAIL_SECURE     Use TLS. Accepts: true | false
MAIL_SECURE=false
# MAIL_USER       SMTP username / API user.
MAIL_USER=
# MAIL_PASS       SMTP password / API key.
MAIL_PASS=
# --- Mail queue (BullMQ) ---
# MAIL_QUEUE_NAME          Queue name. Default mail-queue.
MAIL_QUEUE_NAME=mail-queue
# MAIL_QUEUE_ATTEMPTS      Retry attempts per job. Integer. Default 3.
MAIL_QUEUE_ATTEMPTS=3
# MAIL_QUEUE_BACKOFF       Retry backoff in ms. Integer. Default 5000.
MAIL_QUEUE_BACKOFF=5000
# MAIL_WORKER_CONCURRENCY  Concurrent mail workers. Integer. Default 2.
MAIL_WORKER_CONCURRENCY=2

# =============================================================================
# Redis / Cache
# =============================================================================
# CACHE_DRIVER    Backend. Accepts: redis | valkey. Use `redis` as REDIS_HOST under Docker.
CACHE_DRIVER=redis
# CACHE_SECURE    Use TLS (rediss://). Accepts: true | false
CACHE_SECURE=false
REDIS_USERNAME=myuser
REDIS_PASSWORD=mypassword
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# BullMQ / Jobs
# =============================================================================
# BULLMQ_DB_LOGGING   Persist job logs to the database. Accepts: true | false
BULLMQ_DB_LOGGING=false
# JOB_ENCRYPTION_KEY  REQUIRED. Encrypts job payloads. 32 random bytes as hex (64 chars). App exits if missing.
#                     Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_ENCRYPTION_KEY=

# =============================================================================
# Uploads
# =============================================================================
# MAXIMUM_UPLOAD_SIZE   Max upload size in MB (multiplied by 1024*1024). Integer. Default 10.
MAXIMUM_UPLOAD_SIZE=10

# =============================================================================
# Google OAuth / Maps
# =============================================================================
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   Web OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI       OAuth callback URL registered in Google console.
GOOGLE_REDIRECT_URI=
# GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID   Native app client ids for ID-token verification.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# GOOGLE_MAPS_API_KEY       API key for Maps/Geocoding requests.
GOOGLE_MAPS_API_KEY=

# =============================================================================
# Monitoring
# =============================================================================
# SENTRY_DSN      Sentry ingestion DSN. Leave empty to disable error reporting.
SENTRY_DSN=
